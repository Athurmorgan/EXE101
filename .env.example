# ---- Hạ tầng / Database ----
# Cổng 5432 trên máy đang bị PostgreSQL của Windows chiếm. Docker Postgres
# dùng 5433 để không đụng nhau. Đổi sang 5432 nếu bạn tắt service Windows.
DATABASE_URL="postgresql://vivivu:vivivu@localhost:5433/vivivu?schema=public"
POSTGRES_PORT=5433

# ---- Ứng dụng ----
NODE_ENV=development
PORT=3000
# Ngôn ngữ mặc định khi client không gửi Accept-Language
DEFAULT_LOCALE=vi

# ---- Frontend ----
# Dùng để dựng link xác thực email và quay lại sau khi đăng nhập Google.
FRONTEND_URL=http://localhost:5173

# ---- CORS ----
# Danh sách domain frontend được phép gọi, cách nhau bởi dấu phẩy.
# Khi dev, nên để trống và dùng Vite proxy (cùng origin) để tránh lỗi CORS.
CORS_ORIGINS=http://localhost:5173

# ---- JWT ----
# ĐỔI GIÁ TRỊ NÀY Ở MÔI TRƯỜNG THẬT. Sinh bằng: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-doi-truoc-khi-len-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-only-refresh-secret-doi-truoc-khi-len-production
JWT_REFRESH_EXPIRES_IN=30d

# ---- Cookie ----
# Đặt true khi deploy HTTPS (bắt buộc cho cookie cross-site)
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Đường dẫn cookie — đổi nếu API và FE khác domain
COOKIE_PATH=/api/v1/auth

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Google OAuth (Task 6) ----
# Bỏ trống = tính năng đăng nhập Google bị tắt, API trả 409 kèm thông báo rõ.
# Lấy credential tại https://console.cloud.google.com/apis/credentials
#   - Authorized redirect URI: http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# ---- Gửi email ----
# Chưa cấu hình mail server: mã xác thực được IN RA CONSOLE và trả về trong
# response (chỉ khi NODE_ENV khác production) để tiện kiểm thử.
# Khi lên production, luôn đặt MAIL_ENABLED=true để KHÔNG trả mã trong response.
MAIL_ENABLED=false
MAIL_FROM=no-reply@vivivu.vn
# SMTP: smtps://user:pass@smtp.example.com:465
SMTP_URL=
SMTP_FROM=no-reply@vivivu.vn

# ---- AI service (Task 10) ----
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=
OPENWEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=
