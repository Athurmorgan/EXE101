# Base URL of the vivivu API. Leave as /api/v1 to go through the Vite dev proxy
# (same origin, no CORS, refresh cookie stays first-party). Point it at the real
# host in staging/production, e.g. https://api.vivivu.vn/api/v1
VITE_API_BASE_URL=/api/v1

# Backend host the dev proxy forwards to. Only used when VITE_API_BASE_URL is a
# relative path.
VITE_PROXY_TARGET=http://localhost:3000
