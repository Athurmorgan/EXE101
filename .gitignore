# --- Dependencies ---
node_modules/
.pnp
.pnp.js

# --- Build output ---
dist/
build/
*.tsbuildinfo

# File bien dich chay nham can cua `tsc` khi build trong nham. `packages/shared`
# xuat ra `dist/`, nhung mot lan build sai cau hinh da sinh `index.js` ngay
# trong `src/` — phai ignore de khong commit nham va lam nho Loi package.
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts

# --- Test ---
coverage/
.nyc_output/

# --- Environment (KHONG BAO GIO commit file nay) ---
.env
.env.local
.env.*.local

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Editor / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Python (apps/ai-service) ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
